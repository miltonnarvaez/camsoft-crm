# Copiar a .env y completar antes de docker compose up

POSTGRES_USER=camsoft
POSTGRES_PASSWORD=cambiar_password_seguro
POSTGRES_DB=camsoft_crm

# Evolution API (WhatsApp self-hosted, sin Meta de pago)
EVOLUTION_API_KEY=cambiar_clave_evolution_larga
EVOLUTION_PUBLIC_URL=https://wa.camsoft.com.co
EVOLUTION_INSTANCE=camsoft

# Webhook: URL pública de tu API (Evolution llama aquí)
# URL que Evolution llama al recibir mensajes (debe ser accesible desde Docker)
CAMSOFT_WEBHOOK_URL=https://api.camsoft.com.co/webhooks/whatsapp

# n8n
N8N_HOST=n8n.camsoft.com.co
N8N_PUBLIC_URL=https://n8n.camsoft.com.co

# API Node (fuera de Docker o con host network)
PORT=3847
DATABASE_URL=postgresql://camsoft:cambiar_password_seguro@127.0.0.1:5432/camsoft_crm
JWT_SECRET=cambiar_jwt_secreto_largo
ADMIN_EMAIL=admin@camsoft.com.co
ADMIN_PASSWORD=cambiar_password_admin
CORS_ORIGIN=https://camsoft.com.co
WHATSAPP_ENABLED=true
WHATSAPP_BOT_REPLY=true
# Webhook global Docker activo → no duplicar con webhook de instancia
EVOLUTION_USE_GLOBAL_WEBHOOK=true
# Con webhook OK, desactivar poller de respaldo (evita doble respuesta)
WHATSAPP_POLLER=false
EVOLUTION_API_URL=http://127.0.0.1:8080
